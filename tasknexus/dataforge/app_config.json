{
  "projectName": "dataforge",
  "environment": "development",

  "logging": {
    "level": "debug",
    "destinations": ["console", "file"],
    "filePath": "./logs/dataforge.log",
    "maxFileSizeMb": 50,
    "maxBackupFiles": 5
  },

  "features": {
    "enableDiagnostics": true,
    "enableRealTimeAlerts": false,
    "enableMetrics": true
  },

  "security": {
    "sanitizeInput": true
  }
}
